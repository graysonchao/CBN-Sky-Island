msgstr[0] "копипластина консоли нанофабрикатора (неактивна)"
msgstr[1] "копипластины консоли нанофабрикатора (неактивны)"
msgstr[2] "копипластин консоли нанофабрикатора (неактивны)"

#. ~ Description for {'str': 'Nanofabricator Control Panel copyplate (inert)',
